"""
make_result_figures.py

Editable source for the Results-section figures in the paper
"CALiBRE-AD+: A Nested, Leakage-Audited, Calibrated, Cost-Sensitive Ensemble
for Alzheimer's Disease Classification" (Figs. 3-10).

This is cells 14 and 15 of `alzheimerupdate_version_1.ipynb`, extracted
verbatim into a standalone file so the plotting logic is reviewable and
editable outside the notebook, per the paper's own Reproducibility mapping
(Section VII-A):

    Figs. 3-8  (leakage audit, reliability diagram, cost-threshold curve,
                ROC, PR, confusion matrix)      <- this file, PART 1
    Figs. 9-10 (SHAP summary, SHAP importance)  <- this file, PART 2

IMPORTANT - this script is NOT standalone-runnable on its own. It depends
on objects computed earlier in the notebook's pipeline (cells 0-13):
data loading, the Full/Screening feature split, the nested_run() training
loop, and the resulting T3/SCR/FULL/CALIBRE-AD+ artefacts. Extracting those
upstream cells into this file too would duplicate ~150 lines of modeling
code and risk drifting out of sync with the notebook, which the paper's
own policy (Section VII-A: "the code is the source of truth") explicitly
warns against.

Two ways to use this file:

  1. Recommended - open alzheimerupdate_version_1.ipynb, run cells 0-13
     (the data/audit/nested-CV/table-building pipeline), then run this
     file's code directly in that same kernel (e.g., paste into a new
     cell, or `%run make_result_figures.py` in Jupyter/IPython).

  2. Programmatic - call `render_all(pipeline_state)` below from your own
     driver script after reconstructing the required objects (see the
     REQUIRED VARIABLES list).

REQUIRED VARIABLES (must already exist in scope before running):
  y            - np.ndarray, true Diagnosis labels (Full track)
  X_all        - pd.DataFrame, full predictor matrix (for SHAP)
  CLINICAL     - list[str], the 10 clinical-assessment feature names
  LEARNER_NAMES- list[str], the 7 base-learner names
  T3           - pd.DataFrame, Table III (Full-track performance)
  SCR          - dict, nested_run() output for the Screening track
  build_table  - function, from the notebook (builds a metrics table from
                 a nested_run() result dict)
  FULL         - dict, nested_run() output for the Full track
                 (keys: "meta_raw", "meta_cal", "base_proba", "fold_log", "tau")
  ours_p       - np.ndarray, FULL["meta_cal"] (CALiBRE-AD+ calibrated probs)
  ours_pred    - np.ndarray, thresholded CALiBRE-AD+ predictions at tau[5]
  GRID         - np.ndarray, threshold grid used for the cost-search plot
  RNG          - int, random seed (42 in the paper)

Imports assumed available (same as the notebook's environment - see
06_reproducibility_package/requirements.txt): numpy, pandas, matplotlib,
seaborn, scikit-learn (calibration_curve, brier_score_loss, roc_curve,
precision_recall_curve, confusion_matrix, roc_auc_score), lightgbm
(LGBMClassifier), shap.
"""

import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.calibration import calibration_curve
from sklearn.metrics import (
    brier_score_loss, roc_curve, precision_recall_curve,
    confusion_matrix, roc_auc_score,
)


# ---------------------------------------------------------------------------
# PART 1 — Figs. 3-8 (notebook cell 14)
# ---------------------------------------------------------------------------
def render_figs_3_to_8(y, T3, SCR, LEARNER_NAMES, build_table,
                        FULL, ours_p, ours_pred, GRID, save_dir=None):
    """
    Renders Fig. 3 (leakage audit), Fig. 4 (reliability diagram),
    Fig. 5 (cost-sensitive threshold selection), Fig. 6 (ROC),
    Fig. 7 (precision-recall), and Fig. 8 (confusion matrix).

    If `save_dir` is given (e.g. "figures"), each figure is also saved as
    a PNG matching the filenames referenced by main.tex
    (fig3_leakage_audit.png ... fig8_confusion.png).
    """
    def _save(name):
        if save_dir:
            plt.savefig(f"{save_dir}/{name}.png", dpi=200, bbox_inches="tight")

    # --- Fig. 3: Leakage audit ---
    models = LEARNER_NAMES + ["CALiBRE-AD+"]
    fa = [T3.loc[m, "AUC"] for m in models]
    sa = [build_table(SCR).loc[m, "AUC"] for m in models]
    x = np.arange(len(models))
    w = 0.38
    plt.figure(figsize=(12, 5))
    plt.bar(x - w / 2, fa, w, label="Full", color="#2c6fbb")
    plt.bar(x + w / 2, sa, w, label="Screening-only", color="#e08a1e")
    plt.axhline(0.5, color="#c0392b", ls="--", lw=1)
    plt.xticks(x, models, rotation=40, ha="right")
    plt.ylabel("ROC-AUC")
    plt.ylim(0.4, 1.0)
    plt.title("Fig. 3 — Leakage audit")
    plt.legend()
    plt.tight_layout()
    _save("fig3_leakage_audit")
    plt.show()

    # --- Fig. 4: Reliability diagram ---
    plt.figure(figsize=(6.5, 5.5))
    for p, lab, c in [(FULL["meta_raw"], "Raw stack", "#2c6fbb"),
                       (FULL["meta_cal"], "Calibrated CALiBRE-AD+", "#e08a1e")]:
        ft, mp = calibration_curve(y, p, n_bins=10, strategy="quantile")
        plt.plot(mp, ft, "o-", color=c,
                  label=f"{lab} (Brier={brier_score_loss(y, p):.3f})")
    plt.plot([0, 1], [0, 1], "--", color="gray", label="Perfect")
    plt.xlabel("Mean predicted probability")
    plt.ylabel("Observed frequency")
    plt.title("Fig. 4 — Reliability diagram")
    plt.legend()
    plt.tight_layout()
    _save("fig4_reliability")
    plt.show()

    # --- Fig. 5: Cost-sensitive threshold selection ---
    ts = GRID
    costs = [confusion_matrix(y, (ours_p >= t).astype(int), labels=[0, 1]).ravel()
             for t in ts]
    costs = [5 * fn + fp for tn, fp, fn, tp in costs]
    plt.figure(figsize=(7, 4.6))
    plt.plot(ts, costs, color="#7d4a9e", lw=2)
    mean_tau = float(FULL["fold_log"]["tau_5to1"].mean())
    plt.axvline(mean_tau, color="#c0392b", ls="--",
                label=f"Mean nested threshold={mean_tau:.3f}")
    plt.xlabel("Decision threshold")
    plt.ylabel("Cost (5·FN + FP)")
    plt.title("Fig. 5 — Cost-sensitive threshold selection")
    plt.legend()
    plt.tight_layout()
    _save("fig5_cost_threshold")
    plt.show()

    # --- Figs. 6-7: ROC and Precision-Recall ---
    fig, ax = plt.subplots(1, 2, figsize=(13, 5))
    for name, c in [("XGBoost", "#4c72b0"), ("LightGBM", "#dd8452"),
                     ("CatBoost", "#55a868"), ("CALiBRE-AD+", "#c44e52")]:
        p = ours_p if name == "CALiBRE-AD+" else FULL["base_proba"][name]
        fpr, tpr, _ = roc_curve(y, p)
        ax[0].plot(fpr, tpr, color=c, lw=2, label=f"{name} ({roc_auc_score(y, p):.3f})")
        pr, rc, _ = precision_recall_curve(y, p)
        ax[1].plot(rc, pr, color=c, lw=2, label=name)
    ax[0].plot([0, 1], [0, 1], "--", color="gray")
    ax[0].set_title("Fig. 6 — ROC (Full track)")
    ax[0].set_xlabel("False positive rate")
    ax[0].set_ylabel("True positive rate")
    ax[0].legend()
    ax[1].set_title("Fig. 7 — Precision-Recall (Full track)")
    ax[1].set_xlabel("Recall")
    ax[1].set_ylabel("Precision")
    ax[1].legend()
    plt.tight_layout()
    if save_dir:
        plt.savefig(f"{save_dir}/fig6_roc.png", dpi=200, bbox_inches="tight")
        plt.savefig(f"{save_dir}/fig7_pr.png", dpi=200, bbox_inches="tight")
    plt.show()

    # --- Fig. 8: Confusion matrix ---
    cm = confusion_matrix(y, ours_pred, labels=[0, 1])
    plt.figure(figsize=(5.5, 4.6))
    sns.heatmap(cm, annot=True, fmt="d", cmap="Blues",
                xticklabels=["No AD", "AD"], yticklabels=["No AD", "AD"])
    plt.xlabel("Predicted")
    plt.ylabel("Actual")
    plt.title("Fig. 8 — CALiBRE-AD+ confusion matrix (fold-specific tau)")
    plt.tight_layout()
    _save("fig8_confusion")
    plt.show()
    print("Confusion matrix [[TN, FP], [FN, TP]] =", cm.tolist())


# ---------------------------------------------------------------------------
# PART 2 — Figs. 9-10 (notebook cell 15)
# ---------------------------------------------------------------------------
def render_figs_9_to_10(y, X_all, CLINICAL, RNG, save_dir=None):
    """
    Renders Fig. 9 (SHAP summary plot, LightGBM, Full track) and
    Fig. 10 (mean |SHAP| importance, clinical vs. screening features).

    Requires `shap` and `lightgbm` (see requirements.txt). Fits a fresh
    LightGBM model on the complete dataset for SHAP attribution — this is
    in-sample (see Section VIII-E of the paper, which flags this
    explicitly as a caveat, not an oversight).
    """
    def _save(name):
        if save_dir:
            plt.savefig(f"{save_dir}/{name}.png", dpi=200, bbox_inches="tight")

    try:
        import shap
        from lightgbm import LGBMClassifier
        from matplotlib.patches import Patch

        sm = LGBMClassifier(n_estimators=200, num_leaves=15, learning_rate=0.05,
                             random_state=RNG, verbose=-1).fit(X_all, y)
        sv = shap.TreeExplainer(sm).shap_values(X_all)
        if isinstance(sv, list):
            sv = sv[1]

        # Fig. 9 — SHAP summary
        shap.summary_plot(sv, X_all, max_display=20, show=False)
        _save("fig9_shap_summary")
        plt.show()

        imp = np.abs(sv).mean(0)
        order = np.argsort(imp)[::-1]
        print("SHAP ranking (top 6):")
        for i in order[:6]:
            print(f"  {X_all.columns[i]:<28}{imp[i]:.3f}")

        # Fig. 10 — Mean |SHAP| importance, clinical vs. screening
        top15 = order[:15]
        names = [X_all.columns[i] for i in top15]
        cols = ["#c0392b" if n in CLINICAL else "#2c6fbb" for n in names]
        plt.figure(figsize=(8, 5.5))
        plt.barh(range(15)[::-1], [imp[i] for i in top15], color=cols)
        plt.yticks(range(15)[::-1], names)
        plt.xlabel("mean |SHAP value|")
        plt.legend(handles=[Patch(color="#c0392b", label="Clinical assessment"),
                             Patch(color="#2c6fbb", label="Screening")],
                   loc="lower right")
        plt.title("Fig. 10 — Mean |SHAP| importance")
        plt.tight_layout()
        _save("fig10_shap_importance")
        plt.show()

    except Exception as e:
        print("SHAP skipped:", e)


# ---------------------------------------------------------------------------
# Convenience driver
# ---------------------------------------------------------------------------
def render_all(y, X_all, CLINICAL, LEARNER_NAMES, T3, SCR, build_table,
                FULL, ours_p, ours_pred, GRID, RNG, save_dir=None):
    """Renders all of Figs. 3-10 in one call. See module docstring for the
    full list of required upstream objects (from notebook cells 0-13)."""
    render_figs_3_to_8(y, T3, SCR, LEARNER_NAMES, build_table,
                        FULL, ours_p, ours_pred, GRID, save_dir=save_dir)
    render_figs_9_to_10(y, X_all, CLINICAL, RNG, save_dir=save_dir)


if __name__ == "__main__":
    raise SystemExit(
        "This script defines render_figs_3_to_8(), render_figs_9_to_10(), "
        "and render_all() — it is not meant to be run directly with `python "
        "make_result_figures.py`. Run alzheimerupdate_version_1.ipynb cells "
        "0-13 first (or otherwise construct the REQUIRED VARIABLES listed "
        "in the module docstring), then call render_all(...) with those "
        "objects. See RUN_INSTRUCTIONS.md for the full walkthrough."
    )
